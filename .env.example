# ============================================================
# Traveloop AI Configuration
# ============================================================

# PRIMARY: OpenRouter API Key → Claude opus-4-5
# Get yours at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# FALLBACK: Google Gemini API Key (direct, no OpenRouter)
# Get yours at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# How it works:
# 1. If VITE_OPENROUTER_API_KEY is set → uses anthropic/claude-opus-4-5
# 2. If OpenRouter fails → falls back to Google Gemini 2.0 Flash
# 3. Gemini uses Google Search grounding for real-time info

# ============================================================
# Supabase (optional - app works in demo mode without these)
# ============================================================
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
